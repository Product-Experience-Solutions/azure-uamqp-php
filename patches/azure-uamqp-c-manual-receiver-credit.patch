+int link_set_receiver_credit(LINK_HANDLE link, uint32_t credit)
+{
+    int result;
+
+    if (link == NULL || link->role != role_receiver || link->is_closed ||
+        link->link_state == LINK_STATE_ERROR ||
+        (link->receiver_drain && !link->receiver_drain_complete))
+    {
+        result = MU_FAILURE;
+    }
+    else
+    {
+        link->receiver_credit_manual = true;
+        link->receiver_drain = false;
+        link->receiver_drain_complete = false;
+        link->current_link_credit = credit;
+        result = (link->link_state == LINK_STATE_ATTACHED ||
+            link->link_state == LINK_STATE_HALF_ATTACHED_ATTACH_RECEIVED) ? send_flow(link) : 0;
+    }
+
+    return result;
+}
+
+int link_drain(LINK_HANDLE link)
+{
+    int result;
+
+    if (link == NULL || link->role != role_receiver || link->is_closed ||
+        link->link_state != LINK_STATE_ATTACHED)
+    {
+        result = MU_FAILURE;
+    }
+    else
+    {
+        link->receiver_credit_manual = true;
+        link->receiver_drain = true;
+        link->receiver_drain_complete = false;
+        result = send_flow(link);
+    }
+
+    return result;
+}
+
+int link_get_drain_complete(LINK_HANDLE link, bool* complete)
+{
+    if (link == NULL || complete == NULL || link->role != role_receiver)
+    {
+        return MU_FAILURE;
+    }
+
+    *complete = link->receiver_drain_complete;
+    return 0;
+}
+
 int link_attach(LINK_HANDLE link, ON_TRANSFER_RECEIVED on_transfer_received, ON_LINK_STATE_CHANGED on_link_state_changed, ON_LINK_FLOW_ON on_link_flow_on, void* callback_context)
 {
     int result;
